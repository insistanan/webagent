{
  "manifest_version": 3,
  "name": "WebAgent 2.0 (Web AI MCP Orchestrator)",
  "version": "2.0.1",
  "description": "WebAgent 2.0 专用浏览器扩展，无缝将 DeepSeek / ChatGPT / Kimi / 豆包 / 通义千问 (Qwen) / Duck.ai / Dola / Gemini / AI Studio / Z.ai / Perplexity / Copilot / 当贝 AI 等主流网页端连接至本地智能体核心与 MCP 桥接。支持双独立折叠面板、全自动化执行、智能上下文自愈与多语言国际化。",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.openai.com/*",
    "https://kimi.ai/*",
    "https://www.kimi.ai/*",
    "https://*.kimi.ai/*",
    "https://kimi.moonshot.cn/*",
    "https://*.kimi.moonshot.cn/*",
    "https://kimi.com/*",
    "https://*.kimi.com/*",
    "https://www.doubao.com/*",
    "https://doubao.com/*",
    "https://*.doubao.com/*",
    "https://duck.ai/*",
    "https://*.duck.ai/*",
    "https://duckduckgo.com/*",
    "https://*.duckduckgo.com/*",
    "https://chat.qwen.ai/*",
    "https://*.qwen.ai/*",
    "https://tongyi.aliyun.com/*",
    "https://www.dola.com/*",
    "https://dola.com/*",
    "https://*.dola.com/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://zchat.z.ai/*",
    "https://chat.z.ai/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://copilot.cloud.microsoft/*",
    "https://copilot.microsoft.com/*",
    "https://ai.dangbei.com/*",
    "https://*.dangbei.com/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "https://nexus.358966.xyz/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.openai.com/*",
        "https://kimi.ai/*",
        "https://www.kimi.ai/*",
        "https://*.kimi.ai/*",
        "https://kimi.moonshot.cn/*",
        "https://*.kimi.moonshot.cn/*",
        "https://kimi.com/*",
        "https://*.kimi.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://*.doubao.com/*",
        "https://duck.ai/*",
        "https://*.duck.ai/*",
        "https://duckduckgo.com/chat*",
        "https://*.duckduckgo.com/chat*",
        "https://duckduckgo.com/aichat*",
        "https://*.duckduckgo.com/aichat*",
        "https://duckduckgo.com/?q=DuckDuckGo+AI+Chat*",
        "https://chat.qwen.ai/*",
        "https://*.qwen.ai/*",
        "https://tongyi.aliyun.com/*",
        "https://www.dola.com/*",
        "https://dola.com/*",
        "https://*.dola.com/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://zchat.z.ai/*",
        "https://chat.z.ai/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://copilot.cloud.microsoft/*",
        "https://copilot.microsoft.com/*",
        "https://ai.dangbei.com/*",
        "https://*.dangbei.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
